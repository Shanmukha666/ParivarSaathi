# Browser-safe values (included in the client bundle).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server only. Never prefix either secret with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional external FastAPI service. Leave empty when all family flows use Next.js + Supabase.
NEXT_PUBLIC_API_URL=

# Demo is explicit; never enable it in a production deployment using real data.
PARIVAR_DEMO_MODE=false
NEXT_PUBLIC_PARIVAR_DEMO_MODE=false
