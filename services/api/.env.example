# REQUIRED: the app refuses to start without a secret of at least 32 characters.
# Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/parivar
REDIS_URL=redis://localhost:6379
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order if the primary model is unknown, overloaded or rate limited (comma separated).
GEMINI_FALLBACK_MODELS=gemini-2.5-flash
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-secret
SUPABASE_PUBLISHABLE_KEY=browser-safe-key
AUTH_PROVIDER=supabase
CORS_ORIGINS=http://localhost:3000

# Allow unauthenticated family/demo endpoints only when explicitly enabled.
DEMO_MODE=false
